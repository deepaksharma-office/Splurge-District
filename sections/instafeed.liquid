{%- if section.settings.divider -%}
  <div class="section--divider">
{%- endif -%}

<section
  id="InstagramGallery-{{ section.id }}"
  class="instagram-gallery"
  data-section-id="{{ section.id }}"
  style="
    --ig-bg: {{ section.settings.background_color }};
    --ig-heading-color: {{ section.settings.heading_color }};
    --ig-eyebrow-color: {{ section.settings.eyebrow_color }};
    --ig-line-color: {{ section.settings.line_color }};

    --ig-heading-size: {{ section.settings.heading_size }}px;
    --ig-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --ig-eyebrow-size: {{ section.settings.eyebrow_size }}px;

    --ig-gap: {{ section.settings.image_gap }}px;
    --ig-gap-mobile: {{ section.settings.image_gap_mobile }}px;

    --ig-padding-top: {{ section.settings.padding_top }}px;
    --ig-padding-bottom: {{ section.settings.padding_bottom }}px;

    --ig-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ig-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;

    --ig-header-spacing: {{ section.settings.header_bottom_spacing }}px;
    --ig-header-spacing-mobile: {{ section.settings.header_bottom_spacing_mobile }}px;

    --ig-mobile-slide-width: {{ section.settings.mobile_slide_width }}%;
  "
>

  <div class="instagram-gallery__inner">

    {%- comment -%}
      ============================================================
      HEADER
      ============================================================
    {%- endcomment -%}

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="instagram-gallery__header page-width">

        {%- if section.settings.eyebrow != blank -%}
          <div class="instagram-gallery__eyebrow">

            {%- if section.settings.show_lines -%}
              <span class="instagram-gallery__line"></span>
            {%- endif -%}

            <span>{{ section.settings.eyebrow }}</span>

            {%- if section.settings.show_lines -%}
              <span class="instagram-gallery__line"></span>
            {%- endif -%}

          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="instagram-gallery__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

      </div>
    {%- endif -%}


    {%- comment -%}
      ============================================================
      IMAGE GRID / MOBILE SNAP SLIDER
      ============================================================
    {%- endcomment -%}

    {%- if section.blocks.size > 0 -%}

      <div
        class="
          instagram-gallery__media-wrapper
          {% if section.settings.full_width == false %}
            page-width
          {% endif %}
        "
      >

        <div class="instagram-gallery__grid">

          {%- for block in section.blocks -%}

            <div
              class="instagram-gallery__item"
              {{ block.shopify_attributes }}
            >

              {%- if block.settings.image != blank -%}

                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 400, 500, 600, 800, 1000, 1200',
                    sizes: '(max-width: 768px) 80vw, 25vw',
                    class: 'instagram-gallery__image'
                }}

              {%- else -%}

                <div class="instagram-gallery__placeholder">
                  {{
                    'image'
                    | placeholder_svg_tag: 'placeholder-svg'
                  }}
                </div>

              {%- endif -%}

            </div>

          {%- endfor -%}

        </div>

      </div>

    {%- else -%}

      <div class="instagram-gallery__empty page-width">
        Add image blocks to create the gallery.
      </div>

    {%- endif -%}

  </div>

</section>

{%- if section.settings.divider -%}
  </div>
{%- endif -%}


<style>
  /* =============================================================
     SECTION
     ============================================================= */

  #InstagramGallery-{{ section.id }} {
    width: 100%;
    overflow: hidden;

    background: var(--ig-bg);

    padding-top: var(--ig-padding-top);
    padding-bottom: var(--ig-padding-bottom);
  }


  /* =============================================================
     HEADER
     ============================================================= */

  #InstagramGallery-{{ section.id }} .instagram-gallery__header {
    text-align: center;
    margin-bottom: var(--ig-header-spacing);
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 12px;

    margin-bottom: 14px;

    color: var(--ig-eyebrow-color);

    font-size: var(--ig-eyebrow-size);
    line-height: 1.2;

    letter-spacing: 0.18em;
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__line {
    display: block;

    width: {{ section.settings.line_width }}px;
    height: 1px;

    flex: 0 0 {{ section.settings.line_width }}px;

    background: var(--ig-line-color);
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__heading {
    margin: 0;
    padding: 0;

    color: var(--ig-heading-color);

    font-size: var(--ig-heading-size);
    line-height: 1.05;
  }


  /* =============================================================
     DESKTOP GRID
     ============================================================= */

  #InstagramGallery-{{ section.id }} .instagram-gallery__grid {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: var(--ig-gap);

    width: 100%;
  }


  /* =============================================================
     IMAGE
     ============================================================= */

  #InstagramGallery-{{ section.id }} .instagram-gallery__item {
    position: relative;

    width: 100%;
    min-width: 0;

    aspect-ratio: 1 / 1;

    overflow: hidden;

    background: #111;
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__image {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
    object-position: center;
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__placeholder {
    width: 100%;
    height: 100%;
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__placeholder svg {
    width: 100%;
    height: 100%;
  }


  /* =============================================================
     EMPTY STATE
     ============================================================= */

  #InstagramGallery-{{ section.id }} .instagram-gallery__empty {
    text-align: center;

    padding-top: 30px;
    padding-bottom: 30px;

    color: var(--ig-heading-color);

    opacity: 0.6;
  }


  /* =============================================================
     TABLET
     ============================================================= */

  @media screen and (max-width: 989px) and (min-width: 769px) {

    #InstagramGallery-{{ section.id }} .instagram-gallery__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

  }


  /* =============================================================
     MOBILE — CSS SCROLL SNAP
     ============================================================= */

  @media screen and (max-width: 768px) {

    #InstagramGallery-{{ section.id }} {
      padding-top: var(--ig-padding-top-mobile);
      padding-bottom: var(--ig-padding-bottom-mobile);
    }


    /* -------------------------
       Header
       ------------------------- */

    #InstagramGallery-{{ section.id }} .instagram-gallery__header {
      margin-bottom: var(--ig-header-spacing-mobile);
    }

    #InstagramGallery-{{ section.id }} .instagram-gallery__heading {
      font-size: var(--ig-heading-size-mobile);
    }

    #InstagramGallery-{{ section.id }} .instagram-gallery__eyebrow {
      margin-bottom: 10px;
      gap: 9px;
    }


    /* -------------------------
       Snap slider
       ------------------------- */

    #InstagramGallery-{{ section.id }} .instagram-gallery__media-wrapper {
      width: 100%;

      {% if section.settings.full_width == false %}
        max-width: none;
        padding-left: 0;
        padding-right: 0;
      {% endif %}
    }

    #InstagramGallery-{{ section.id }} .instagram-gallery__grid {
      display: flex;

      width: 100%;

      gap: var(--ig-gap-mobile);

      overflow-x: auto;
      overflow-y: hidden;

      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;

      -webkit-overflow-scrolling: touch;

      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;

      scrollbar-width: none;
    }

    #InstagramGallery-{{ section.id }} .instagram-gallery__grid::-webkit-scrollbar {
      display: none;
    }

    #InstagramGallery-{{ section.id }} .instagram-gallery__item {
      flex:
        0 0
        var(--ig-mobile-slide-width);

      width: var(--ig-mobile-slide-width);

      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

  }
</style>


{% schema %}
{
  "name": "Instagram gallery",
  "class": "index-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Instagram handle",
      "default": "@splurgedistrict"
    },
    {
      "type": "checkbox",
      "id": "show_lines",
      "label": "Show lines beside handle",
      "default": true
    },
    {
      "type": "range",
      "id": "line_width",
      "label": "Line width",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow Us on Instagram"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#070707"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Handle color",
      "default": "#d5ae30"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#d5ae30"
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size - desktop",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size - mobile",
      "min": 20,
      "max": 50,
      "step": 1,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Handle size",
      "min": 8,
      "max": 22,
      "step": 1,
      "default": 10,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width images",
      "default": true
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Desktop image gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 6,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_gap_mobile",
      "label": "Mobile image gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 8,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Mobile slider"
    },
    {
      "type": "range",
      "id": "mobile_slide_width",
      "label": "Image width",
      "min": 60,
      "max": 100,
      "step": 5,
      "default": 80,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "label": "Side spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Header spacing"
    },
    {
      "type": "range",
      "id": "header_bottom_spacing",
      "label": "Space below header - desktop",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 35,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_bottom_spacing_mobile",
      "label": "Space below header - mobile",
      "min": 10,
      "max": 70,
      "step": 5,
      "default": 25,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 180,
      "step": 5,
      "default": 70,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 180,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show section divider",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram gallery",
      "category": "Image",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "footer",
      "header",
      "custom.popups"
    ]
  }
}
{% endschema %}