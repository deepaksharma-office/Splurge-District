{%- liquid
  assign desktop_image = block.settings.image
  assign mobile_image = block.settings.mobile_image
-%}

<div
  class="hero-media-block"
  {{ block.shopify_attributes }}
  style="
    --hero-media-position: {{ block.settings.image_position }};
    --hero-media-position-mobile: {{ block.settings.mobile_image_position }};
    --hero-media-overlay: {{ block.settings.overlay_color }};
    --hero-media-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-media-bg: {{ block.settings.background_color }};
  "
>
  {%- if desktop_image != blank -%}
    <picture class="hero-media-block__picture">
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 768px)"
          srcset="
            {{ mobile_image | image_url: width: 480 }} 480w,
            {{ mobile_image | image_url: width: 750 }} 750w,
            {{ mobile_image | image_url: width: 1000 }} 1000w,
            {{ mobile_image | image_url: width: 1400 }} 1400w
          "
          sizes="100vw"
        >
      {%- endif -%}

      {{
        desktop_image
        | image_url: width: 3840
        | image_tag:
          loading: 'lazy',
          widths: '750, 1000, 1400, 1800, 2200, 2800, 3200, 3840',
          sizes: '100vw',
          class: 'hero-media-block__image'
      }}
    </picture>
  {%- else -%}
    <div class="hero-media-block__placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  {%- if block.settings.show_overlay -%}
    <div class="hero-media-block__overlay"></div>
  {%- endif -%}
</div>

{% stylesheet %}
  .hero-media-block {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--hero-media-bg);
    pointer-events: none;
  }

  .hero-media-block__picture,
  .hero-media-block__image,
  .hero-media-block__placeholder,
  .hero-media-block__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-media-block__image {
    object-fit: cover;
    object-position: var(--hero-media-position);
  }

  .hero-media-block__placeholder svg {
    object-fit: cover;
  }

  .hero-media-block__overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-media-overlay);
    opacity: var(--hero-media-overlay-opacity);
  }

  @media screen and (max-width: 768px) {
    .hero-media-block__image {
      object-position: var(--hero-media-position-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Desktop image is used when blank."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Center left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Center right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Center left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Center right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background",
      "default": "#050505"
    },

    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 25,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Hero image"
    }
  ]
}
{% endschema %}
