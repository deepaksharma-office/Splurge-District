<div
  class="hero-buttons-block{% if block.settings.stack_on_mobile %} hero-buttons-block--stack-mobile{% endif %}"
  {{ block.shopify_attributes }}
  style="
    --hero-buttons-gap: {{ block.settings.gap }}px;
    --hero-buttons-margin-top: {{ block.settings.margin_top }}px;
    --hero-buttons-margin-bottom: {{ block.settings.margin_bottom }}px;
    --hero-button-font-size: {{ block.settings.font_size }}px;
    --hero-button-font-size-mobile: {{ block.settings.font_size_mobile }}px;
    --hero-button-padding-y: {{ block.settings.padding_vertical }}px;
    --hero-button-padding-x: {{ block.settings.padding_horizontal }}px;
    --hero-button-radius: {{ block.settings.border_radius }}px;

    --hero-button-1-bg: {{ block.settings.button_1_background }};
    --hero-button-1-text: {{ block.settings.button_1_text_color }};
    --hero-button-1-border: {{ block.settings.button_1_border_color }};

    --hero-button-2-bg: {{ block.settings.button_2_background }};
    --hero-button-2-text: {{ block.settings.button_2_text_color }};
    --hero-button-2-border: {{ block.settings.button_2_border_color }};
  "
>
  {%- if block.settings.button_1_label != blank -%}
    <a
      {% if block.settings.button_1_link != blank %}
        href="{{ block.settings.button_1_link }}"
      {% else %}
        role="link"
        aria-disabled="true"
      {% endif %}
      class="hero-buttons-block__button hero-buttons-block__button--1 hero-buttons-block__button--{{ block.settings.button_1_style }}"
    >
      <span>{{ block.settings.button_1_label }}</span>

      {%- if block.settings.button_1_arrow -%}
        <span class="hero-buttons-block__arrow" aria-hidden="true">→</span>
      {%- endif -%}
    </a>
  {%- endif -%}

  {%- if block.settings.button_2_label != blank -%}
    <a
      {% if block.settings.button_2_link != blank %}
        href="{{ block.settings.button_2_link }}"
      {% else %}
        role="link"
        aria-disabled="true"
      {% endif %}
      class="hero-buttons-block__button hero-buttons-block__button--2 hero-buttons-block__button--{{ block.settings.button_2_style }}"
    >
      <span>{{ block.settings.button_2_label }}</span>

      {%- if block.settings.button_2_arrow -%}
        <span class="hero-buttons-block__arrow" aria-hidden="true">→</span>
      {%- endif -%}
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .hero-buttons-block {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hero-buttons-gap);
    margin-top: var(--hero-buttons-margin-top);
    margin-bottom: var(--hero-buttons-margin-bottom);
  }

  .hero-buttons-block__button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: var(--hero-button-padding-y) var(--hero-button-padding-x);
    border: 1px solid transparent;
    border-radius: var(--hero-button-radius);
    font-size: var(--hero-button-font-size);
    line-height: 1.2;
    font-weight: 600;
    text-decoration: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .hero-buttons-block__button:hover {
    opacity: 0.88;
  }

  .hero-buttons-block__button--1.hero-buttons-block__button--filled {
    background: var(--hero-button-1-bg);
    color: var(--hero-button-1-text);
    border-color: var(--hero-button-1-border);
  }

  .hero-buttons-block__button--1.hero-buttons-block__button--outline {
    background: transparent;
    color: var(--hero-button-1-text);
    border-color: var(--hero-button-1-border);
  }

  .hero-buttons-block__button--1.hero-buttons-block__button--text {
    min-height: 0;
    padding-left: 0;
    padding-right: 0;
    background: transparent;
    color: var(--hero-button-1-text);
    border-color: transparent;
    border-bottom-color: var(--hero-button-1-border);
    border-radius: 0;
  }

  .hero-buttons-block__button--2.hero-buttons-block__button--filled {
    background: var(--hero-button-2-bg);
    color: var(--hero-button-2-text);
    border-color: var(--hero-button-2-border);
  }

  .hero-buttons-block__button--2.hero-buttons-block__button--outline {
    background: transparent;
    color: var(--hero-button-2-text);
    border-color: var(--hero-button-2-border);
  }

  .hero-buttons-block__button--2.hero-buttons-block__button--text {
    min-height: 0;
    padding-left: 0;
    padding-right: 0;
    background: transparent;
    color: var(--hero-button-2-text);
    border-color: transparent;
    border-bottom-color: var(--hero-button-2-border);
    border-radius: 0;
  }

  .hero-buttons-block__arrow {
    font-size: 1.25em;
    line-height: 1;
  }

  @media screen and (max-width: 768px) {
    .hero-buttons-block__button {
      font-size: var(--hero-button-font-size-mobile);
    }

    .hero-buttons-block--stack-mobile {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-buttons-block--stack-mobile .hero-buttons-block__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero buttons",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Label",
      "default": "Shop Black Label"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_1_style",
      "label": "Style",
      "options": [
        { "value": "filled", "label": "Filled" },
        { "value": "outline", "label": "Outline" },
        { "value": "text", "label": "Text link" }
      ],
      "default": "filled"
    },
    {
      "type": "checkbox",
      "id": "button_1_arrow",
      "label": "Show arrow",
      "default": true
    },
    {
      "type": "color",
      "id": "button_1_background",
      "label": "Background",
      "default": "#d7a52b"
    },
    {
      "type": "color",
      "id": "button_1_text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_1_border_color",
      "label": "Border color",
      "default": "#d7a52b"
    },

    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Label",
      "default": "Explore The Collection"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Style",
      "options": [
        { "value": "filled", "label": "Filled" },
        { "value": "outline", "label": "Outline" },
        { "value": "text", "label": "Text link" }
      ],
      "default": "text"
    },
    {
      "type": "checkbox",
      "id": "button_2_arrow",
      "label": "Show arrow",
      "default": true
    },
    {
      "type": "color",
      "id": "button_2_background",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_2_text_color",
      "label": "Text color",
      "default": "#d7a52b"
    },
    {
      "type": "color",
      "id": "button_2_border_color",
      "label": "Border color",
      "default": "#d7a52b"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
